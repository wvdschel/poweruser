#!/bin/bash

if [[ $(cat /sys/class/power_supply/BAT0/status) == Discharging ]]; then
  echo 42000000 > /sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0/hwmon/hwmon4/power1_cap
else
  echo 100000000 > /sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/0000:02:00.0/0000:03:00.0/hwmon/hwmon4/power1_cap
fi
